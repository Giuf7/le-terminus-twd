<?xml version="1.0" encoding="UTF-8"?>
<!-- Zones du serveur TWD, carte "Old Yicesewa Valley" (graine TWD_Georgia, 8192, générée le 17/11/2026).
     - Hors de toute zone : PvE (defaultPvp="false").
     - pvp="true"  : zone PvP. Les dégâts entre joueurs ne passent que si l'attaquant ET la victime y sont.
       Chaque zone PvP reçoit aussi un véhicule abandonné (TWD_Vehicles).
     - pvp="false" : zone sûre, prioritaire sur une zone PvP qui la contient.
     - Cercle : x, z, radius. Rectangle : x1, z1, x2, z2. (x = Est/Ouest, z = Nord/Sud, en mètres)
     Ajustement en jeu : commande console "twdzones" (voir LISTE.md). -->
<zones defaultPvp="false">
	<!-- La grande ville du sud-ouest : 11 gratte-ciel, hôpital, base militaire.
	     Rectangle = partie construite (tuiles de ville), sauf la rangée sud, pour laisser la prison (-3633, -2721) hors zone. -->
	<zone name="Atlanta" pvp="true" x1="-3800" z1="-2600" x2="-2600" z2="-1550" />
	<!-- La ville du centre de la carte (2 gratte-ciel) -->
	<zone name="Terminus" pvp="true" x="-749" z="340" radius="200" />
	<!-- La ville du nord-ouest (4 gratte-ciel, hôpital) -->
	<zone name="Woodbury" pvp="true" x="-2560" z="1980" radius="250" />
</zones>
