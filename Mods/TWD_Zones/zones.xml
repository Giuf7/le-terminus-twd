<?xml version="1.0" encoding="UTF-8"?>
<!-- Zones du serveur TWD, carte "Toditabi Territory" (graine TWD_Plan_v1, 10240, générée le 17/11/2026 selon le plan :
     Alexandria au centre, prison à l'ouest, Atlanta au nord-est, Woodbury au sud-est, Terminus au sud-ouest).
     - Hors de toute zone : PvE (defaultPvp="false"). Alexandria, ville neutre, n'a donc pas de zone.
     - pvp="true"  : zone PvP. Les dégâts entre joueurs ne passent que si l'attaquant ET la victime y sont.
       Chaque zone PvP reçoit aussi un véhicule abandonné (TWD_Vehicles).
     - pvp="false" : zone sûre, prioritaire sur une zone PvP qui la contient.
     - Cercle : x, z, radius. Rectangle : x1, z1, x2, z2. (x = Est/Ouest, z = Nord/Sud, en mètres)
     Mesures faites dans prefabs.xml (96 % des bâtiments de chaque ville). Ajustement en jeu : commande "twdzones". -->
<zones defaultPvp="false">
	<!-- Nord-est : la très grande ville (~740 bâtiments, 28 tours, base militaire, hôpital) -->
	<zone name="Atlanta" pvp="true" x1="2900" z1="350" x2="4850" z2="2300" />
	<!-- Sud-est : petite ville résidentielle (90 % des bâtiments à moins de 480 m) -->
	<zone name="Woodbury" pvp="true" x="2980" z="-3149" radius="520" />
	<!-- Sud-ouest : ville industrielle (90 % des bâtiments à moins de 550 m) -->
	<zone name="Terminus" pvp="true" x="-2471" z="-2806" radius="580" />
	<!-- Ouest, à mi-chemin d'Alexandria et du bord : la prison, isolée -->
	<zone name="Prison" pvp="true" x="-2344" z="-548" radius="200" />
</zones>
